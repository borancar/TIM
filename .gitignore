__pycache__/
.venv/
out/
*.o
!reconstruct/*.png
# Everything the Makefile builds. `tim`, `devtim`, `timdbg` and `timasan` were
# here already; `libtim.so`, `covtim` and gcov's notes were not, and were
# tracked - so a 1.1 MB shared library went into the history on nearly every
# commit that touched a `.c` file, nine times in one session before anyone
# noticed. The blobs already in the history stay there; this stops more.
reconstruct/tim
reconstruct/devtim
reconstruct/timdbg
reconstruct/timasan
reconstruct/covtim
reconstruct/libtim.so
*.gcno
*.gcda

# Captured machine states. Deliberately not tracked: a snapshot is a whole
# emulated machine, it is only valid for the emulator commit pyproject.toml
# pins, and it is reproduced by playing to the state again. Keep the ones you
# need; do not expect them to survive a pin move.
snaps/
tools/native/native
tools/native/syms.c
tools/native/ovlsyms.c
tools/native/shims.c

# **The game itself.** `incredible-machine/` is the original 1993 release -
# TIM.EXE, the RESOURCE archives and the shipped .TIM machines - and it is
# Dynamix/Sierra's, not ours. It was committed in the very first commit and
# rode along in all 645 that followed until `git filter-branch` took it out of
# every one of them.
#
# The reconstruction *needs* these files on disk: the emulator loads TIM.EXE
# and every tool in `tools/` reads the archives through `tools/tim.py`. So they
# stay in the working tree and are never tracked. Supply your own copy.
incredible-machine/

# Snapshots of a running game hold the whole guest memory image - the
# original executable and its level data. They are reached by playing and are
# worth keeping locally; they are not ours to publish. `out/` is already
# ignored for the same reason.
solution_snaps/
*.snap
*.snap.sp
*.solution
