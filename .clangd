# clangd, for editor navigation. `compile_commands.json` at the repository root
# is the real answer and is generated by `make -C reconstruct compile_commands`;
# this only covers what that file cannot.
CompileFlags:
  # A header opened on its own has no entry in compile_commands.json, so give
  # clangd enough to parse one: the port's headers live beside io.c, and the
  # game's sources under src/ reach them as "io.h", "tim.h", "dgroup.h".
  #
  # **Nothing is removed here**: an editor that disagrees with the build about
  # warnings is worse than one with no configuration at all.
  #
  # If `clangd --check` on a file reports hundreds of "errors", they are almost
  # certainly not diagnostics. It runs every code action at every token and
  # counts the refusals - `SwapBinaryOperands` declining to rewrite inside a
  # FAR_PTR macro, hundreds of times. `clang -fsyntax-only` with the flags from
  # compile_commands.json is the honest check, and reports zero errors and zero
  # warnings on the same file.
  #
  # The absolute path below is this checkout's. clangd has no variable for the
  # project root; on another machine the include simply does not resolve, which
  # costs header-only navigation and nothing else.
  Add: [-std=c11, -I/home/boran/git/TIM/reconstruct]

Diagnostics:
  # The transcriptions are full of deliberate integer juggling that mirrors
  # 16-bit code, and clang-tidy's opinions about it are noise here.
  ClangTidy:
    Remove: [readability-*, bugprone-narrowing-conversions, cppcoreguidelines-*]
  UnusedIncludes: None
