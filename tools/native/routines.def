/*
 * Which routines the emulator must not execute, because the port has them.
 *
 * NOT a transcription, and **not compiled**: `tools/native/genshims.py` reads
 * this and writes `shims.c`, one typed shim per line below. This file is the
 * declaration; the shim is the call Borland would have compiled, with the
 * conversion to the port's own types checked by the compiler rather than by a
 * table of widths.
 *
 *   FAR_C (addr, nargs, ret, fn)      far, the caller cleans up
 *   NEAR_P(addr, nargs, pops, ret, fn) near, and the callee pops `pops` bytes
 *   OVL_C (addr, nargs, ret, fn)      far, and the address is into VM.OVL
 *   REG_N (addr, regs, nargs, ret, fn) arguments in registers, not on the stack
 *   OVL_R (addr, fn)                  a driver routine taking registers
 *   FAR_R (addr, ret, fn)             far, and its arguments are in registers
 *   FAR_P (addr, nargs, pops, ret, fn) far, and the callee pops `pops` bytes
 *
 * **Eight of the driver's routines take registers, not a stack frame.** They
 * begin `mov ah, al` or `jb 0x965`, not `push bp`, and dispatching them as
 * stack calls read eight words of rubbish as arguments - which is what smeared
 * the second intro screen while the first one matched exactly. Their register
 * lists are in genshims.py, taken from what each routine's own transcription
 * records: `vm_span` says "AL the colour, BX the x, CX the count, ES:DI the
 * row" and means it.
 *
 * Every one of those four facts is read off the routine, never inferred from
 * its neighbours. `dos_creat` sits among thirteen far, caller-cleaned DOS
 * wrappers and is near and pascal - `ret 4` at 0x0d59a - and taking it for one
 * of them desynchronises the guest's stack, which surfaces as a crash
 * somewhere else entirely.
 */
/*
     * The DOS wrappers. All far and caller-cleaned, except where marked.
     * Addresses and conventions read from the disassembly; see the note above
     * about the one that differs.
     */
    FAR_C (0x0b6b7, 2, RET_AX,   dos_findfirst),
    FAR_C (0x0b6d3, 2, RET_AX,   dos_findnext),
    FAR_C (0x0b755, 1, RET_AX,   dos_chdir),
    FAR_C (0x0b794, 1, RET_AX,   dos_unlink),
    FAR_C (0x0bd4a, 1, RET_NONE, dos_getdate),
    FAR_C (0x0c018, 1, RET_AX,   dos_isatty),
    FAR_C (0x0c0c3, 4, RET_DXAX, dos_lseek),
    FAR_C (0x0c185, 3, RET_AX,   dos_read),
    FAR_C (0x0c8a3, 4, RET_AX,   dos_ioctl),
    FAR_C (0x0cd3d, 3, RET_AX,   dos_getattr),
    FAR_C (0x0cd80, 1, RET_AX,   dos_close),
    FAR_C (0x0d707, 2, RET_AX,   dos_open_named),
    FAR_C (0x0b7b3, 1, RET_NONE, dos_get_cur_dir),
    FAR_C (0x0bd70, 1, RET_DXAX, dos_getvect),
    FAR_C (0x0bd7f, 3, RET_NONE, dos_setvect),
    FAR_C (0x0b819, 1, RET_NONE, dos_setdisk),
    FAR_C (0x0df7a, 3, RET_AX,   dos_write),

    /*
     * The stdio layer above them. Dispatching these as well as the DOS
     * wrappers is not belt and braces: `read_tim_cfg` divided by zero with
     * only the wrappers native, because the buffering above them was still
     * being emulated. Reusing the port's is the point of the exercise.
     */
    FAR_C (0x0ce15, 1, RET_AX,   stdio_fclose),
    FAR_C (0x0ce92, 1, RET_AX,   flush_stream),
    FAR_C (0x0d0ce, 2, RET_AX,   stdio_fopen),
    FAR_C (0x0d1c4, 4, RET_AX,   stdio_fread),
    FAR_C (0x0d26c, 4, RET_AX,   stdio_fseek),
    FAR_C (0x0d404, 1, RET_AX,   stdio_fgetc),
    FAR_C (0x0c27b, 1, RET_DXAX, dos_tell),
    FAR_C (0x0da6d, 3, RET_AX,   read_translated),

    /*
     * What adapter the machine has. The original asks the BIOS - `int 10h
     * ah=1a`, then `ah=12h bl=10` - and CLAUDE.md records what happens when
     * nothing answers: the game decides there is no VGA and no EGA, fails to
     * load VM.OVL and prints "Unable to initialize vm." There is no BIOS here
     * either, and the port's version already knows the answer.
     */
    { 0x225d2, "detect_adapter", (void *)detect_adapter, 0, 0, 0, 0, 0, 0,
      RET_AX, 0, 0 },   /* near: it ends `ret`, unlike most of this file */

    /* The mouse driver, INT 33h. There is none here; the io layer is it. */
    FAR_C (0x21f1d, 0, RET_AX,   mouse_init),
    FAR_C (0x0b859, 1, RET_NONE, mouse_set_speed),
    FAR_C (0x21f8d, 4, RET_NONE, mouse_set_ranges),
    FAR_C (0x21fbe, 2, RET_NONE, mouse_set_user_handler),
    FAR_C (0x2200f, 0, RET_NONE, mouse_save_vga),
    FAR_C (0x22074, 0, RET_NONE, mouse_restore_vga),
    FAR_C (0x22113, 2, RET_AX,   mouse_move_to),

    /* The sound driver's timer, and the keyboard handler. Both take their
     * own vectors, which is why they reach `int 21h` with dos_getvect
     * already dispatched - they do not go through it. */
    /* NOT dispatched: `timer_install` is left to the guest so that its own
     * handler goes into the IVT and `deliver_int` can run it. Its `int 21h`
     * AH=35/25 are the vector table, which native.c answers. */

    /* The keyboard handler's installation - it takes its own vector. */
    FAR_C (0x21094, 1, RET_AX,   install_keyboard),

    /*
     * Drawing. These are the routines verified against the original earlier,
     * so the intro and the briefing are drawn by the port rather than by the
     * guest - which is what "a native graphics layer" means once the driver
     * underneath it is already native.
     *
     * `restore_write_mode` is here for its own sake: it is the routine
     * `load_screen_plain` was calling wrongly until today, and having the port
     * do both halves keeps the pair honest.
     */
    FAR_C (0x1e94c, 0, RET_NONE, restore_write_mode),

    /*
     * The polygon filler. Register arguments, which is why the table needed
     * them: none of these takes anything on the stack. `poly_edge_vertical`
     * disagrees with the four that take two x's about which register holds
     * which end, so each has its own list rather than a shared one.
     *
     * All near but `clip_polygon`, which ends `retf` at 0x21087.
     */
    REG_N (0x1f562, R_poly_walk, 7, RET_NONE, poly_walk),
    REG_N (0x1f265, R_edge_vert, 4, RET_NONE, poly_edge_vertical),
    REG_N (0x1f3bf, R_edge_two,  5, RET_NONE, poly_edge_diagonal),
    REG_N (0x1f281, R_edge_two,  5, RET_NONE, poly_edge_steep),
    REG_N (0x1f3e6, R_edge_two,  5, RET_NONE, poly_edge_shallow_right),
    REG_N (0x1f4a1, R_edge_two,  5, RET_NONE, poly_edge_shallow_left),
    REG_N (0x1f219, R_outline,   3, RET_NONE, poly_outline),
    FAR_C (0x20c07, 0, RET_NONE, clip_polygon),

    /*
     * Display timing. Far, with the argument at [bp+6]; it programs the CRTC
     * directly, which is what the port trap caught it doing.
     */
    FAR_C (0x08f77, 1, RET_NONE, vm_set_display_lines),

    /*
     * The driver's own bring-up. Dispatched because the overlay's routines
     * cannot be bound until the game has recorded where the loader put it -
     * `vm_init` is what writes that pointer to DGROUP 0x48f4, and it calls into
     * the driver *before* it does. So the emulator would reach the driver's
     * mode-set with nothing yet bound, which is what it did.
     */
    FAR_C (0x22483, 3, RET_AX, vm_init),

    /*
     * **The video driver.** Every routine VM.OVL has that the port has too,
     * which is all of them but `vm_blit_scaled` - that one is still a stub,
     * and is deliberately left out so the game reaching it aborts with a
     * backtrace rather than being quietly emulated.
     *
     * Addresses come from the port's own provenance comments rather than a
     * hand-kept list. Reading them with a regex over the whole comment picked
     * a later `VGA:` mentioned in prose for two of them - 0x254 for
     * `vm_span_dithered`, which is really 0x027a - so they are taken from
     * `provenance.check`, which reads only the first line. That is the same
     * trap the annotator hit and the same one that put two wrong values in
     * part_inits.
     */
    OVL_C(0x0000, 3, RET_AX,   vm_driver_init),
    OVL_C(0x011d, 0, RET_NONE, vm_reset_attributes),
    OVL_C(0x0252, 0, RET_NONE, vm_nothing),
    OVL_R(0x027a, vm_span_dithered),
    OVL_R(0x034f, vm_span),
    OVL_R(0x03db, vm_blit_scaled_row),
    OVL_R(0x0938, vm_blit_run),
    OVL_R(0x0998, vm_draw_line),
    OVL_R(0x0be6, vm_fill_spans),
    OVL_C(0x0ec1, 4, RET_NONE, sh_vm_set_palette),
    OVL_C(0x0f15, 2, RET_NONE, vm_load_palette),
    OVL_C(0x0f57, 4, RET_NONE, vm_blend_palette),
    OVL_C(0x0fd4, 2, RET_DXAX, vm_bitmap_list_size),
    OVL_C(0x1015, 5, RET_NONE, vm_load_bitmap_list),
    OVL_C(0x10b8, 5, RET_NONE, vm_chunky_to_planar),
    OVL_C(0x11bb, 5, RET_NONE, vm_read_four_planes),
    OVL_C(0x11ee, 5, RET_NONE, vm_build_mask_plane),
    OVL_R(0x124b, vm_blit_glyph),
    OVL_C(0x12fb, 6, RET_NONE, vm_save_rect),
    OVL_C(0x138e, 2, RET_DXAX, vm_buffer_size),
    OVL_C(0x13b9, 6, RET_NONE, vm_restore_rect),
    OVL_C(0x1453, 2, RET_AX,   vm_read_pixel),
    OVL_C(0x14c9, 3, RET_AX,   vm_plot_pixel),
    OVL_C(0x150f, 1, RET_NONE, vm_show_page),
    OVL_C(0x1561, 4, RET_NONE, vm_copy_rect),
    OVL_C(0x15d0, 6, RET_NONE, vm_blit_rows),
    OVL_C(0x1707, 4, RET_NONE, vm_blit_bitmap),

    /*
     * Memory. `dos_alloc_bytes` is what the first useful trap this runner
     * produced pointed at - `game_main` -> `game_startup` -> here, issuing
     * `int 21h ah=48` - and it is the reason the arena never has to be
     * modelled: the io layer answers the allocation instead.
     */
    FAR_C (0x21abd, 4, RET_DXAX, dos_alloc_bytes),
    FAR_C (0x21b34, 2, RET_NONE, dos_free_far),

    /* Near, and the callee removes its own arguments: `ret 4` and `ret 2`. */
    NEAR_P(0x0d584, 2, 4, RET_AX,   dos_creat),
    NEAR_P(0x0d59d, 1, 2, RET_NONE, dos_truncate),

    /*
     * Arithmetic the intro reaches. Read from the disassembly rather than
     * assumed from the family, which this project has been caught by before:
     * each of these takes its arguments off the stack with `mov bx,sp` and
     * `[bx+4]` - so far, and the frame is where far_args expects it - and each
     * ends a plain `retf` with no immediate, so the caller cleans up.
     *
     * `mul16x16` answers in DX:AX because that is where a 16x16 `imul` leaves
     * a 32-bit product; the other two answer a word in AX.
     */
    FAR_C (0x2a269, 2, RET_DXAX, mul16x16),
    FAR_C (0x2a456, 1, RET_AX,   angle_sin),
    FAR_C (0x2a47b, 1, RET_AX,   angle_cos),

    /*
     * The far block moves. Both build a frame and read five words from
     * `[bp+6]` up, both end a plain `retf`, so far and the caller cleans up.
     *
     * `far_move` at 0x0bd2e is deliberately **not** here. It ends `retf 8` -
     * far *and* pascal - and takes its count in CX besides, and there is no
     * macro above for that shape. Forcing it into FAR_C would leave eight
     * bytes on the guest's stack every call and read the count off the stack
     * where it never was. It needs a form that does not exist yet.
     */
    FAR_C (0x222c6, 5, RET_NONE, far_memcpy),
    FAR_C (0x22300, 5, RET_NONE, far_memset),

    /*
     * The game's file layer, which sits on top of the `stdio_` routines that
     * were already dispatched - the slice traces spend most of the intro in
     * these. Every one builds a frame and ends a plain `retf`: far, and the
     * caller cleans up.
     *
     * Their arguments are near pointers into DGROUP where they are pointers
     * at all, so a word each, and DGROUP is the same bytes on both sides -
     * that is what makes handing these over safe rather than a copy problem.
     */
    FAR_C (0x08fcd, 2, RET_AX,   game_fopen),
    FAR_C (0x0917f, 1, RET_AX,   game_fclose),
    FAR_C (0x091ef, 4, RET_AX,   game_fread),
    FAR_C (0x092dc, 4, RET_AX,   game_fseek),
    FAR_C (0x093a2, 1, RET_DXAX, game_ftell),
    FAR_C (0x093e0, 1, RET_NONE, game_rewind),
    FAR_C (0x093f6, 1, RET_AX,   game_fgetc),

    /*
     * The string and fill helpers, all far and all ending a plain `retf`.
     * Several have two exits and both were read; a routine whose second
     * return is `retf N` while its first is not would be a trap worth the
     * looking, and none of these is one.
     *
     * Near pointers into DGROUP again, a word each.
     *
     * Four of the six are exercised by the intro - string_concat 278 calls,
     * near_memset 401, string_copy 140, int_to_string 139. string_compare_
     * nocase and string_copy_padded are not called once, so their conventions
     * are **read but not tested**: the screens cannot vouch for them and the
     * first screen that reaches them is what will.
     */
    FAR_C (0x0dc95, 2, RET_AX,   string_concat),
    FAR_C (0x0dd33, 2, RET_AX,   string_copy),
    FAR_C (0x0dd55, 2, RET_AX,   string_compare_nocase),
    FAR_C (0x0ddaf, 3, RET_AX,   string_copy_padded),
    FAR_C (0x0d543, 3, RET_AX,   near_memset),
    FAR_C (0x0d4bd, 3, RET_AX,   int_to_string),

    /*
     * The allocator. CLAUDE.md's warning is that ten allocator routines use
     * four different conventions, so every one of these was read twice: the
     * spec's argument offsets start at 4, which is a far frame measured
     * against the original, and each ends a plain `retf` with no immediate.
     * The ones with three exits had all three read.
     *
     * These are the entries where sharing the guest's memory stops being a
     * convenience and starts being the point. The heap's rings and its break
     * are words in DGROUP; the port walks the same bytes the emulated code
     * does, so an allocation made by one is seen by the other. Nothing is
     * handed over or copied, which is why the two can be interleaved at all.
     *
     * The far wrappers are exercised - heap_calloc_far 401 calls,
     * heap_free_far 169, heap_malloc_far 116, string_copy_far 1. The three
     * inner ones are called **nought** times and will stay that way: their
     * only callers are the wrappers, and a dispatched wrapper calls them as C
     * rather than through the emulator.
     *
     * Worth knowing before reading the queue as a count. Dispatching an outer
     * routine takes its callees off the emulator's path with it, so the work
     * remaining shrinks faster than one per entry - and an entry whose callers
     * are all dispatched can never be exercised by any screen. These three are
     * kept for the screens that reach them directly, and are read rather than
     * measured until one does.
     */
    FAR_C (0x0bb1e, 1, RET_AX,   heap_malloc_far),
    FAR_C (0x0bb2d, 1, RET_NONE, heap_free_far),
    FAR_C (0x0bb4f, 2, RET_AX,   string_copy_far),
    FAR_C (0x0bb75, 2, RET_AX,   heap_calloc_far),
    FAR_C (0x0c833, 2, RET_AX,   heap_calloc),
    FAR_C (0x0c8ca, 1, RET_NONE, heap_free),
    FAR_C (0x0c999, 1, RET_AX,   heap_malloc),

    /*
     * Borland's long arithmetic, which takes its 32-bit values in register
     * pairs - DX:AX and CX:BX - and answers in DX:AX. There was no way to
     * declare that here until the pair form was added to genshims.py; a word
     * per parameter cannot say "the high half is in DX".
     *
     * `long_multiply` is **near**: it ends `ret` at 0x0c184 where its twin at
     * 0x0bcf6 ends `retf`. They are the same instructions - the linker pulled
     * __LMUL in twice - and one byte apart in how they return, which is the
     * sort of thing that costs an afternoon when it is assumed. The other
     * three end `retf` and are far.
     *
     * `long_shift_left` is near for a reason worth writing down. 0x0be3e is
     * `pop bx / push cs / push bx` - a **thunk**, not the routine: the caller
     * makes a near call and those three instructions manufacture the far
     * return the body at 0x0be41 needs for its `retf`. Dispatched as far, the
     * shim reads four bytes of return address where the caller pushed two, and
     * the guest limps - 405 frames where it makes 640, which reads as a
     * slowdown and is a corrupted stack. 0x0be5f is the same thunk for
     * long_shift_right, whose far body at 0x0be62 is what is declared here.
     *
     * Reading the first three instructions is what tells the two apart, and
     * `retf` at the end says nothing about how the routine was entered.
     */
    REG_N (0x0c16e, 4, 2, RET_DXAX, long_multiply),
    REG_N (0x0be3e, 3, 2, RET_DXAX, long_shift_left),
    FAR_R (0x0be62,       RET_DXAX, long_shift_right),
    FAR_R (0x0bf0a,       RET_DXAX, huge_add),

    /*
     * The compressed-bitmap decoder, which is where the emulator spends the
     * intro: sampling the guest's position every four hundred slices put it
     * in here for 92 of about 145 samples, more than everything else together.
     *
     * 0x20185 is a thunk too, but a different one and harmless: `ljmp
     * [0x44ea]`, and the port's own note records 0x44ea measured pointing at
     * the instruction after it - a vector that exists to be repointed, not to
     * reach another module. A jump does not touch the stack, so the frame the
     * body reads at [bp+6] is the caller's far frame and FAR_C is right. The
     * body ends a single `retf` at 0x20653.
     */
    FAR_C (0x20185, 4, RET_NONE, draw_compressed_bitmap),

    /*
     * What the sampling showed next, once the decoder was gone: the resource
     * stream's own reader. Three of these are **near** - a plain `ret`, not
     * `retf` - because their callers are in the same module, and the fourth
     * is far. Read one at a time; the family is not uniform and nothing about
     * sitting next to each other made them so.
     *
     * `apply_contact_friction` is left out. It is in the sampling too, and its
     * return is further out than the window read, so it is not yet known
     * whether it is near, far or pascal. Guessing it from its neighbours is
     * exactly the move that put a corrupted stack behind a slowdown earlier.
     */
    NEAR_P(0x1c389, 0, 0, RET_AX,   next_input_byte),
    NEAR_P(0x1c3e6, 2, 0, RET_AX,   read_input_block),
    NEAR_P(0x1c970, 0, 0, RET_NONE, lzw_reset),
    FAR_C (0x11dd1, 2, RET_NONE, game_fread_far),

    /*
     * The rest of what the sampling names, each bounded by the next symbol in
     * the table rather than by a window guessed at - which is how
     * apply_contact_friction's return was missed the first time. Read
     * properly it is far and ends a plain `retf` at 0x03008.
     *
     * `next_lzw_code` does not even build a frame: it begins
     * `mov ax, [0x58a0]` and ends `ret`. Near, no arguments.
     *
     * `load_bitmaps` is the one that found the `guest_sp` bug - it reserves
     * 0xa2 bytes with dg_enter, and until the shim set the port's stack
     * pointer from the guest's, those bytes landed on live guest memory.
     */
    FAR_C (0x25300, 4, RET_NONE, draw_bitmap),
    FAR_C (0x24f72, 1, RET_AX,   load_bitmaps),
    FAR_C (0x11e3f, 2, RET_NONE, read_record_fields),
    FAR_C (0x02da0, 1, RET_NONE, apply_contact_friction),
    FAR_C (0x03ba9, 3, RET_AX,   intersect_segments),
    NEAR_P(0x1cc65, 0, 0, RET_AX, next_lzw_code),

    /*
     * And what the sampling named after those: the LZW decompressor itself,
     * 33 of 50 samples, and the Huffman bit reader. Both near, both taking no
     * arguments at all.
     *
     * `decompress_lzw` saves BP without making a frame of it - `push bp / push
     * si`, no `mov bp,sp` - which is what a routine with no stack arguments
     * looks like and is worth not mistaking for the start of one that has
     * them.
     */
    NEAR_P(0x1ca62, 0, 0, RET_AX, decompress_lzw),
    NEAR_P(0x1dfd6, 0, 0, RET_AX, huff_get_bit),
    NEAR_P(0x1e338, 1, 0, RET_NONE, huffman_update),

    /*
     * `decompress_lzss`, which is what the last of the profile was really in.
     * The samples read as `huffman_update+0x208` and the code at 0x1e52d is
     * inline in *this* routine in the port - a tree walk that the original
     * reaches by a jump. Dispatching the container is what takes it off the
     * emulator; there was never a routine missing.
     *
     * `decode_position` at 0x1e561 is deliberately not here. It ends with a
     * **jump** into 0x1e7f2 rather than a `ret` - the port's own note at
     * seg1c25.c says so - so a shim would simulate a return the original never
     * makes, and the guest would resume at an address it was never going to.
     */
    NEAR_P(0x1e7f2, 0, 0, RET_AX, decompress_lzss),

    /*
     * The tail of the profile, where nothing is worth more than a couple of
     * samples and these are taken for completeness rather than for effect.
     * Three far, two near, each read with the routine bounded by the next
     * symbol.
     *
     * `find_edge_contact` and `step_machine` are here too, and were nearly not:
     * bounding them by "the next symbol" said they had no return at all, which
     * is what a routine ending in a jump looks like. The bound was wrong.
     * syms.c holds two tables now - the image's and VM.OVL's - and the
     * driver's offsets run to 0x271b, so they collide with low image
     * addresses: 0x00f86 was being bounded by `vm_bitmap_list_size` at
     * overlay 0x00fd4, seventy-eight bytes in. Read to the next *image*
     * symbol, both end a plain `retf`, at 0x00b6b and 0x01215.
     *
     * A bound taken from the wrong table does not look wrong. It looks like a
     * routine with no return, which is a real thing this file already has two
     * of, so it reads as a finding rather than as a mistake.
     */
    FAR_C (0x02ac0, 0, RET_NONE, recompute_kind_physics),
    FAR_C (0x03b17, 3, RET_NONE, rotate_point),
    FAR_C (0x16db1, 4, RET_NONE, draw_part),
    NEAR_P(0x1c8a7, 0, 0, RET_NONE, resource_advance),
    NEAR_P(0x1c92b, 2, 0, RET_AX,   resource_read),
    FAR_C (0x007af, 1, RET_AX,   find_edge_contact),
    FAR_C (0x00f86, 0, RET_NONE, step_machine),

    /*
     * `atan2_long` is far and ends a plain `retf` at 0x2d3b6. A byte survey of
     * the queue had it down as far *pascal* - it found a 0xca somewhere in the
     * routine's data - which is why a survey is a survey and the routine still
     * gets read.
     *
     * `ulong_divide` at 0x0bd97 is **not** here. It is `pop cx / push cs /
     * push cx`, the same near-to-far thunk as long_shift_left built on a
     * different register, and its body is shared with long_divide at 0x0bd93
     * through a signedness flag in CX that the thunk itself sets. Two entries
     * into one body, one of them near: not something to declare from a
     * distance.
     */
    FAR_C (0x2d296, 4, RET_AX, atan2_long),

    /*
     * Borland's stream layer, and the first pascal routines here besides
     * `dos_creat`: near, and the callee takes its own arguments off. Each pop
     * count was read from the routine's `ret N` and then **checked against the
     * prototype** - two bytes a word, every one of the six - because a pops
     * count that is wrong by a word desynchronises the guest's stack and
     * surfaces somewhere else entirely, which is the note at the top of this
     * file about `dos_creat`.
     *
     * `long_to_string` at 0x0c029 and `stdio_setvbuf` at 0x0db5e are left out.
     * Both show *two different* pop counts inside their bounds - `ret 0xc` and
     * `ret 4` in the one, a `retf` before a `ret 6` in the other - so there is
     * a second routine in there and which return belongs to which entry is not
     * settled by reading the ends.
     *
     * **None of the six is called once.** They were taken to exercise the
     * pascal path, which only `dos_creat` and `dos_truncate` use, and they do
     * not: their callers - stdio_fopen, stdio_fread and the rest - are
     * dispatched already, so the port reaches them as ordinary C and the
     * emulator never does. The path is still unexercised and this tranche did
     * not change that.
     *
     * They are kept for the screens that reach them directly. Until one does,
     * the only thing vouching for these pop counts is that each matches its
     * prototype at two bytes a word - which is a real check and is not a
     * measurement.
     */
    NEAR_P(0x0bfcd, 1, 2, RET_AX, io_error),
    NEAR_P(0x0cf4d, 3, 6, RET_AX, parse_open_mode),
    NEAR_P(0x0d007, 4, 8, RET_AX, stdio_fopen_into),
    NEAR_P(0x0d0ed, 3, 6, RET_AX, buffered_read),
    NEAR_P(0x0d20f, 1, 2, RET_AX, unread_count),
    NEAR_P(0x0d396, 1, 2, RET_AX, refill_stream),

    /*
     * What `TIM_ENTRIES` says the emulator is still running, which is a
     * different list from what the original reached and a much shorter one:
     * 182 routines, and `frame_pending` is fifteen million of the calls. It is
     * the guest's wait for the next frame - `mov ax,[0x5754]`, negate, sbb,
     * inc - spun on until the timer handler sets the word.
     *
     * `bit0_of_468c` uses BP as a frame pointer **without pushing it**: `cli /
     * mov dx,bp / mov bp,sp`, so its argument is at [bp+4] where every other
     * far routine here has it at [bp+6]. Still a far frame - the four bytes
     * below are the return address - and still four words for the shim to
     * skip, but the disassembly does not look like the others and the offset
     * is the only thing that says so.
     */
    FAR_C (0x0b4e2, 0, RET_AX,   frame_pending),
    FAR_C (0x05ba7, 2, RET_AX,   pick_for_record),
    FAR_C (0x07ce3, 1, RET_NONE, shift_state_history),
    FAR_C (0x2147d, 1, RET_AX,   bit0_of_468c),

    /*
     * The next tier by call count. Four far, one near, all ending plainly.
     *
     * `timer_tick` at 0x20767 is 643 of those calls and is **not** here. It
     * ends `iret`, not `retf`: it is the 8253's handler, entered by the
     * interrupt the loop delivers, and the machine owes it six bytes back -
     * offset, segment and flags. Every return this file can express pops four
     * or two. A shim would leave the flags on the guest's stack and every
     * later return would read one word too high, which is a corruption that
     * starts one interrupt later and looks like anything but this.
     *
     * There is no macro for it and there should not be one until an interrupt
     * handler is worth dispatching; `iret` is not a calling convention, it is
     * a different mechanism wearing the same shape.
     */
    FAR_C (0x2213e, 1, RET_AX,   flag_bit_48ea),
    FAR_C (0x04b8f, 1, RET_AX,   rope_ends_close),
    FAR_C (0x04b53, 2, RET_AX,   points_within_140),
    FAR_C (0x03d2e, 1, RET_NONE, step_pair_apart),
    NEAR_P(0x1c649, 1, 0, RET_AX, select_resource),

    /*
     * The tier below that, all far and all a plain `retf`.
     *
     * `normalise_far_ptr` at 0x22161 is left out though it is 323 calls. Its
     * prototype takes `uint16_t *` twice - the port passes host pointers to
     * its own locals - where the guest hands it a far pointer in AX:DX and
     * takes the answer back the same way; far_memset calls it with `mov ax,di
     * / mov dx,es / call`. The port's signature and the original's convention
     * do not describe the same call, and no shim reconciles that. Its far
     * face at 0x22386 does take a stack frame and is here.
     */
    FAR_C (0x05b65, 1, RET_AX,   pick_by_flag),
    FAR_C (0x0a7a3, 0, RET_NONE, clear_flag_2d44),
    FAR_C (0x0b542, 2, RET_AX,   button_state),
    FAR_C (0x1d868, 4, RET_AX,   read_resource),
    FAR_C (0x22386, 2, RET_DXAX, normalise_far_ptr_far),
    FAR_C (0x06f8e, 3, RET_AX,   link_end_distance),
    FAR_C (0x0713d, 3, RET_AX,   link_slack),

    /*
     * All far, all a plain `retf`; heap_check has five exits and every one was
     * read. It takes no arguments and does not build a frame - `push si` is
     * its whole prologue.
     *
     * **Two of this batch hang the guest and are not here.**
     *
     * `wait_and_latch_frame` at 0x0aaca waits for the next frame. Dispatched,
     * the port waits for a frame the emulator can only produce by returning
     * from the call the port is blocked inside. The run stops at nine frames
     * having drawn a correct nine.
     *
     * `update_button_state` at 0x08136 does the same thing for input, and
     * cost the longer diagnosis: with both in, removing the obvious one left
     * the hang exactly where it was, which reads as "not that after all"
     * rather than "not only that". Two routines with the same fault in one
     * tranche is the case the one-at-a-time rule in native.h is for.
     *
     * Neither is a convention problem. A shim can only run a routine to
     * completion and hand back an answer, and these two are not meant to
     * complete until something outside them happens - which, here, is the
     * emulator that is waiting for them.
     */
    FAR_C (0x0811b, 0, RET_NONE, clear_flag_2d44_thunk),
    FAR_C (0x08125, 0, RET_NONE, restore_cursor_following),
    FAR_C (0x166ef, 1, RET_NONE, link_record_into_buckets),
    FAR_C (0x220e9, 2, RET_NONE, read_pair_4740),
    FAR_C (0x08528, 0, RET_NONE, heap_check_or_hang),
    FAR_C (0x0cb45, 0, RET_AX,   heap_check),

    FAR_C (0x05c77, 1, RET_NONE, set_object_extent),
    FAR_C (0x06994, 1, RET_NONE, belt_in_dirty_rect),
    FAR_C (0x082c3, 0, RET_NONE, set_clip_for_mode),
    NEAR_P(0x27a86, 0, 0, RET_NONE, flush_pending_volumes),
    FAR_C (0x27ace, 0, RET_NONE, sound_service),
    NEAR_P(0x27b7e, 0, 0, RET_NONE, poll_sequences),

    FAR_C (0x0467d, 1, RET_NONE, select_cursor),
    FAR_C (0x05646, 2, RET_NONE, insert_sorted),
    FAR_C (0x05d1e, 1, RET_NONE, part_finish_angles),
    FAR_C (0x08546, 1, RET_NONE, regions_handle_pointer),
    FAR_C (0x166d6, 0, RET_NONE, clear_word_array_50bf),
    FAR_C (0x1675e, 2, RET_NONE, draw_machine),
    FAR_C (0x1d983, 4, RET_DXAX, resource_seek),
    FAR_C (0x081cc, 1, RET_NONE, present_frame),

    FAR_C (0x0144e, 0, RET_NONE, step_word_4e87),
    FAR_C (0x06699, 0, RET_NONE, replay_shapes),
    FAR_C (0x06806, 0, RET_NONE, mark_parts_in_dirty_rects),
    FAR_C (0x06b5b, 0, RET_NONE, refile_overlapping_parts),
    FAR_C (0x07ca2, 0, RET_NONE, shift_all_histories),
    FAR_C (0x0ee6e, 1, RET_NONE, draw_frame_corners),
    FAR_C (0x0f7f4, 1, RET_NONE, load_part_bitmap),
    FAR_C (0x16181, 1, RET_NONE, step_and_draw_machine),

    FAR_C (0x05be4, 1, RET_NONE, place_object_for_draw),
    FAR_C (0x11d44, 1, RET_AX,   lookup_table_546c),
    FAR_C (0x14133, 1, RET_AX,   make_part),
    FAR_C (0x29f89, 3, RET_DXAX, alloc_for_kind),
    NEAR_P(0x1c6e3, 1, 0, RET_AX,   string_contains_r),
    NEAR_P(0x1c705, 1, 0, RET_NONE, free_if_set),
    NEAR_P(0x23df2, 1, 0, RET_AX,   find_file_record),
    NEAR_P(0x23e70, 3, 0, RET_AX,   string_equal_upto),
    FAR_C (0x0a7ae, 0, RET_NONE, timer_callback),

    NEAR_P(0x1c71a, 1, 0, RET_AX, close_resource_slot),
    NEAR_P(0x1c783, 0, 0, RET_AX, open_resource_slot),
    NEAR_P(0x1c7d5, 2, 0, RET_AX, prepare_resource_slot),
    FAR_C (0x1d54e, 5, RET_AX, open_resource),
    FAR_C (0x1d798, 1, RET_AX, close_resource),
    FAR_C (0x29da0, 2, RET_AX, read_record),

    /*
     * `copy_rect_thunk` is `ljmp [0x4356]` and nothing else - the same kind of
     * vector as draw_compressed_bitmap's at 0x20185, repointable and not
     * reaching another module. A jump leaves the caller's far frame alone, so
     * FAR_C is right; the four words are read where the body would read them.
     *
     * `free_for_kind` at 0x2a017 is left out: `ret` and `retf` both appear
     * inside its bounds, so there is more than one routine in there and the
     * ends do not say which return is its.
     */
    FAR_C (0x21088, 4, RET_NONE, copy_rect_thunk),

    /*
     * `huge_equal` at 0x0bd0d is **not** here, and the reason is a lesson
     * about specs. It takes four words in AX, DX, BX and CX - measured, and
     * the entry agrees, `push cx / mov ch,al` with no frame - so FAR_R
     * expresses the arguments exactly. Declared with RET_AX the intro breaks.
     *
     * Its spec has no `returns=True`, which means the verifier has never
     * checked what it answers or where. The argument registers are measured;
     * the return is not, and RET_AX was a guess wearing the same confidence.
     * A spec vouches for what it checks and for nothing else, and the list of
     * keys it does not have is as much a part of reading it as the ones it
     * does.
     */

    /*
     * Two batches, checked apart: the geometry three, then the sound chain.
     * After a tranche where two routines shared one fault and removing the
     * obvious one left the symptom untouched, batches here are small enough
     * that a hang names itself.
     *
     * flush_pending_volumes and poll_sequences are near and called nought
     * times - their caller is sound_service, dispatched with them, so the port
     * reaches them as C. Only sound_service crosses from the emulator, 160
     * times, once a frame.
     */
